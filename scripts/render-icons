#!/usr/bin/env bash
# Re-render the app icons, the favicon, and the page logo from scripts/logo.jpg. Needs ImageMagick 7.
set -euo pipefail

cd "$(dirname "$0")/.."

# The logo's mark without its wordmark, which would be illegible at icon size. The crop stops
# short of the wordmark, which starts at y=1694 in the 2000px source.
crop=1376x1515+312+150
# The mark is cut out by its blue channel: the logo's cream and white background never drops below
# 213 there, and the teal and gold stay below 179 except at anti-aliased edges.
cutout="70%,83%"
# Wide enough that the mark's bounding box fits Android's maskable safe zone, a circle of 40%
# of the icon's width, so one image serves every purpose.
canvas=2200

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mark="$tmp/mark.png"
master="$tmp/master.png"

magick scripts/logo.jpg -crop "$crop" +repage \
  \( +clone -channel B -separate +channel -level "$cutout" -negate \) \
  -alpha off -compose copy-opacity -composite "$mark"

# The -18 offset centers the mark, which sits 18px below the crop's center.
magick -size "${canvas}x${canvas}" radial-gradient:"#FFFBF3-#F5EEDD" "$mark" \
  -gravity center -geometry +0-18 -compose over -composite "$master"

render() {
  magick "$master" -resize "$1x$1" -strip -depth 8 "PNG24:$2"
}

for size in 192 512; do
  render "$size" "public/icon-${size}.png"
done

render 180 public/apple-touch-icon.png

# Three times the largest size a page shows it at, so it stays sharp on a phone.
magick "$mark" -trim +repage -resize x288 -strip -depth 8 PNG32:public/logo-mark.png

# On a vellum tile, since the teal and the mark's white details vanish on a dark tab bar.
magick "$mark" -trim +repage -resize 400x400 \
  \( -size 480x480 xc:none -fill "#F5EEDD" -draw "roundrectangle 0,0 479,479 96,96" \) +swap \
  -gravity center -compose over -composite -define icon:auto-resize=48,32,16 src/app/favicon.ico
