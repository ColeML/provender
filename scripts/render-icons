#!/usr/bin/env bash
# Re-render the manifest icons in public/ from scripts/icon.svg. Needs ImageMagick 7.
set -euo pipefail

cd "$(dirname "$0")/.."

for size in 192 512; do
  magick -density 576 -background none scripts/icon.svg -resize "${size}x${size}" -strip \
    -depth 8 "PNG24:public/icon-${size}.png"
done
