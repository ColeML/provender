# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Two connection strings, and they are not interchangeable. Both are set for you in Vercel by the
# Neon integration; locally, point them at a Neon branch rather than a local Postgres — the free
# tier includes 10 branches, so there is nothing to install.

# Pooled (host contains `-pooler`). What the app queries through at runtime.
DATABASE_URL=

# Direct. Used only by `pnpm db:migrate`: pooled connections do not support the session-level
# state DDL needs.
DATABASE_URL_UNPOOLED=

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────
# Two independent credentials, because there are two kinds of caller: a browser signs in with the
# shared password and gets a session cookie; Claude Code sends a bearer token and never touches
# the cookie. Neither mechanism can admit the other's caller.

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# scrypt hash of the shared household password, as `<salt-hex>:<key-hex>`.
# Generate with: pnpm tsx scripts/hash-password.ts  (it prompts; the password is not echoed)
# The password itself is never stored anywhere.
AUTH_PASSWORD_HASH=

# The agent's bearer token for /v1. Generate with: openssl rand -hex 32
PROVENDER_API_TOKEN=
